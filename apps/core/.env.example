# Copy to apps/core/.env.development.local.
PORT=3000
SWAGGER_ENABLED=true

# PostgreSQL exposed by docker-compose.yml on the host.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=receipt_tracker
DB_USERNAME=receipt_tracker
# Must match POSTGRES_PASSWORD in the root .env.
DB_PASSWORD=replace_with_your_local_password

# Optional process variables, set before starting the application:
# NODE_ENV=development (default environment used to select env files)
# ENV_FILE_PATH=apps/core/.env.development.local (Core only)
